{
  "info": {
    "name": "Hernan Dimitri - Backend Challenge - Trading API",
    "description": "Colección repetible de principio a fin para X-User-Id: 1 en http://localhost:8080 sin configurar nada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Portfolio",
      "item": [
        {
          "name": "Get User Portfolio (User 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/portfolio",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "portfolio"
              ]
            }
          }
        }
      ]
    },
